{#
/**
 * @file
 * Al-Baron products — filters + results (AJAX-swappable fragment).
 *
 * Available: products, filters, active, active_summary, total.
 */
#}
<div class="products-layout">

  {# ---- Faceted filter sidebar ---- #}
  <aside class="filters" id="product-filters" aria-label="{{ 'Product filters'|t }}">
    <div class="filters__head">
      <span class="filters__title">{{ 'Refine'|t }}</span>
      <div class="filters__head-actions">
        {% if active %}
          <a href="{{ path('albaron_core.products') }}" class="filters__reset js-filter">{{ 'Reset all'|t }}</a>
        {% endif %}
        <button type="button" class="filters__close" aria-label="{{ 'Close'|t }}">&times;</button>
      </div>
    </div>

    {% for group in filters %}
      <div class="filter-group">
        <span class="filter-group__title">{{ group.label }}</span>
        <div class="filter-list">
          {% for opt in group.options %}
            <a href="{{ opt.url }}"
               class="filter-option js-filter{{ opt.active ? ' is-active' }}{{ (opt.count == 0 and not opt.active) ? ' is-disabled' }}"
               data-facet="{{ group.key }}" data-tid="{{ opt.tid }}"
               {{ opt.active ? 'aria-pressed="true"' }}>
              <span class="filter-option__box">
                <svg class="filter-option__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span class="filter-option__label">{{ opt.name }}</span>
              <span class="filter-option__count">{{ opt.count }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </aside>

  {# ---- Results ---- #}
  <div class="products-main">
    <button type="button" class="filters-toggle" aria-expanded="false" aria-controls="product-filters">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8L3 5z"/></svg>
      <span>{{ 'Filters'|t }}</span>
      {% if active_summary %}<span class="filters-toggle__count">{{ active_summary|length }}</span>{% endif %}
    </button>
    <div class="products-toolbar">
      <span class="products-count">{{ '@count results'|t({'@count': total}) }}</span>
      {% if active_summary %}
        <div class="active-filters">
          {% for a in active_summary %}
            <a href="{{ a.clear }}" class="active-filter js-filter" data-facet="{{ a.facet }}" data-tid="{{ a.tid }}" aria-label="{{ 'Remove filter'|t }}: {{ a.name }}">
              {{ a.name }} <span aria-hidden="true">&times;</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if products %}
      <div class="grid grid--3 products-grid">
        {% for p in products %}
          <article class="card" data-reveal data-reveal-delay="{{ loop.index0 % 3 }}">
            <a href="{{ p.url }}" class="card__media">
              {% if p.image %}<img src="{{ p.image.src }}" alt="{{ p.image.alt }}" loading="lazy">{% endif %}
              <span class="card__media-overlay"><span class="card__view">{{ 'View details'|t }} &rarr;</span></span>
            </a>
            <div class="card__body">
              {% if p.family %}<span class="badge">{{ p.family }}</span>{% endif %}
              <h3 class="card__title" style="margin-top:.8rem;"><a href="{{ p.url }}">{{ p.title }}</a></h3>
              <dl class="card-specs">
                {% if p.colors %}<div><dt>{{ 'Colour'|t }}</dt><dd>{{ p.colors|join(', ') }}</dd></div>{% endif %}
                {% if p.finishes %}<div><dt>{{ 'Finish'|t }}</dt><dd>{{ p.finishes|join(', ') }}</dd></div>{% endif %}
                {% if p.dimensions %}<div><dt>{{ 'Size'|t }}</dt><dd>{{ p.dimensions }}</dd></div>{% endif %}
                {% if p.applications %}<div><dt>{{ 'Uses'|t }}</dt><dd>{{ p.applications|join(', ') }}</dd></div>{% endif %}
              </dl>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="form-card" style="text-align:center;">
        <h3>{{ 'No products match these filters'|t }}</h3>
        <p>{{ 'Try adjusting or clearing your filters to see more of the collection.'|t }}</p>
        <a href="{{ path('albaron_core.products') }}" class="btn btn--primary btn--sm js-filter">{{ 'Clear filters'|t }}</a>
      </div>
    {% endif %}
  </div>

  <div class="filters-backdrop" aria-hidden="true"></div>

</div>
