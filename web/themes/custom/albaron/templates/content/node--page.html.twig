{#
/**
 * @file
 * Al-Baron — basic page (About, Capabilities, etc.).
 */
#}
<article{{ attributes }}>
  <section class="page-banner">
    <div class="page-banner__media" aria-hidden="true">
      <img src="{{ file_url(directory ~ '/home-hero.webp') }}" alt="" fetchpriority="high">
    </div>
    <div class="container container--wide">
      <span class="eyebrow">Al-Baron</span>
      <h1>{{ label }}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow" style="margin-inline:auto;" data-reveal>
      {{ content }}
    </div>
  </section>
</article>
