{#
/**
 * @file
 * Al-Baron home page.
 *
 * Available: featured, families, gallery, stats.
 */
#}
<section class="hero">
  <div class="hero__media">
    {% if gallery.0 %}
      <img src="{{ gallery.0.large }}" alt="{{ 'Al-Baron natural stone'|t }}" fetchpriority="high">
    {% endif %}
  </div>
  <div class="container container--wide">
    <div class="hero__inner">
      <span class="eyebrow">{{ 'Bethlehem · Palestine · Since 1998'|t }}</span>
      <h1>{{ 'The Enduring Beauty of'|t }} <em>{{ 'Palestinian Stone'|t }}</em></h1>
      <p class="lead">{{ 'Premium natural stone & marble — quarried, hand-finished and export-ready for architects, developers and stone traders worldwide.'|t }}</p>
      <div class="hero__cta">
        <a href="{{ path('albaron_core.products') }}" class="btn btn--primary">{{ 'Explore the Collection'|t }}</a>
        <a href="{{ path('albaron_core.contact') }}" class="btn btn--ghost">{{ 'Request a Quote'|t }}</a>
      </div>
    </div>
  </div>
  <div class="hero__scroll">{{ 'Scroll'|t }}</div>
</section>

{# Trust / stats #}
<section class="section section--tight section--panel">
  <div class="container container--wide">
    <div class="stats">
      {% for stat in stats %}
        <div class="stat">
          <div class="stat__num">{{ stat.num }}</div>
          <div class="stat__label">{{ stat.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# Intro #}
<section class="section">
  <div class="container">
    <div class="split">
      <div data-reveal>
        <span class="eyebrow">{{ 'Who We Are'|t }}</span>
        <h2>{{ 'A heritage of stone, refined for the world’s finest projects.'|t }}</h2>
        <p class="lead">{{ 'From the historic quarries around Bethlehem, Al-Baron transforms raw Palestinian limestone and marble into precision-finished materials trusted on facades, floors and landmark interiors across the globe.'|t }}</p>
        <p>{{ 'Every block is selected for character and consistency, then cut, finished and packed to exacting export standards — so what you specify is exactly what arrives on site.'|t }}</p>
        <a href="/about" class="btn btn--ghost">{{ 'Our Story'|t }}</a>
      </div>
      <div class="grid grid--2" data-reveal data-reveal-delay="1">
        {% for img in gallery|slice(1, 4) %}
          <div class="card" data-lightbox><div class="card__media"><img src="{{ img.src }}" data-large="{{ img.large }}" alt="{{ img.alt }}" loading="lazy"></div></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# Featured products #}
{% if featured %}
<section class="section section--panel">
  <div class="container container--wide">
    <div class="section-head section-head--center" data-reveal>
      <span class="eyebrow">{{ 'Signature Selection'|t }}</span>
      <h2>{{ 'Featured Stone & Marble'|t }}</h2>
    </div>
    <div class="grid grid--3">
      {% for p in featured %}
        <article class="card" data-reveal data-reveal-delay="{{ loop.index0 % 3 }}">
          <a href="{{ p.url }}" class="card__media">
            {% if p.image %}<img src="{{ p.image.src }}" alt="{{ p.image.alt }}" loading="lazy">{% endif %}
            <span class="card__media-overlay"><span class="card__view">{{ 'View details'|t }} &rarr;</span></span>
          </a>
          <div class="card__body">
            {% if p.family %}<span class="badge">{{ p.family }}</span>{% endif %}
            <h3 class="card__title" style="margin-top:.8rem;"><a href="{{ p.url }}">{{ p.title }}</a></h3>
            <dl class="card-specs">
              {% if p.finishes %}<div><dt>{{ 'Finish'|t }}</dt><dd>{{ p.finishes|join(', ') }}</dd></div>{% endif %}
              {% if p.dimensions %}<div><dt>{{ 'Size'|t }}</dt><dd>{{ p.dimensions }}</dd></div>{% endif %}
              {% if p.applications %}<div><dt>{{ 'Uses'|t }}</dt><dd>{{ p.applications|join(', ') }}</dd></div>{% endif %}
            </dl>
          </div>
        </article>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:3rem;">
      <a href="{{ path('albaron_core.products') }}" class="btn btn--primary">{{ 'View All Products'|t }}</a>
    </div>
  </div>
</section>
{% endif %}

{# Explore by material #}
{% if families %}
<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ 'Browse the Range'|t }}</span>
      <h2>{{ 'Explore by Material'|t }}</h2>
    </div>
    <div class="chips" style="gap:.8rem;" data-reveal>
      {% for f in families %}
        <a href="{{ f.url }}" class="chip" style="padding:.7rem 1.3rem;font-size:.95rem;">{{ f.name }}</a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# Capabilities #}
<section class="section section--panel">
  <div class="container container--wide">
    <div class="section-head section-head--center" data-reveal>
      <span class="eyebrow">{{ 'Why Al-Baron'|t }}</span>
      <h2>{{ 'Built for Export Confidence'|t }}</h2>
    </div>
    <div class="grid grid--3">
      <div class="feature-card" data-reveal>
        <div class="feature-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div>
        <h3>{{ 'Quarry to Quay'|t }}</h3>
        <p>{{ 'Full control from extraction to finishing and export packing ensures consistent color, thickness and quality across every order.'|t }}</p>
      </div>
      <div class="feature-card" data-reveal data-reveal-delay="1">
        <div class="feature-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 6 9 17l-5-5"/></svg></div>
        <h3>{{ 'Certified Quality'|t }}</h3>
        <p>{{ 'Rigorous selection, calibrated finishes and documented quality controls — ready for demanding international specifications.'|t }}</p>
      </div>
      <div class="feature-card" data-reveal data-reveal-delay="2">
        <div class="feature-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"/></svg></div>
        <h3>{{ 'Global Delivery'|t }}</h3>
        <p>{{ 'Experienced export logistics and secure crating deliver Palestinian stone reliably to projects across the Gulf, Europe and beyond.'|t }}</p>
      </div>
    </div>
  </div>
</section>

{# CTA #}
<section class="section">
  <div class="container">
    <div class="cta-band" data-reveal>
      <span class="eyebrow" style="justify-content:center;">{{ 'Start Your Project'|t }}</span>
      <h2 style="max-width:20ch;margin-inline:auto;">{{ 'Let’s bring timeless stone to your next build.'|t }}</h2>
      <p class="lead" style="max-width:52ch;margin-inline:auto;">{{ 'Tell us about your project and our export team will respond with samples, specifications and pricing.'|t }}</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:1.8rem;">
        <a href="{{ path('albaron_core.contact') }}" class="btn btn--primary">{{ 'Request a Quote'|t }}</a>
        <a href="{{ path('albaron_core.products') }}" class="btn btn--ghost">{{ 'Download Catalogue'|t }}</a>
      </div>
    </div>
  </div>
</section>
