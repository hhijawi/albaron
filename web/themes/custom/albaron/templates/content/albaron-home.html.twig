{#
/**
 * @file
 * Al-Baron home page.
 *
 * Available: featured, families, gallery, stats.
 */
#}
<section class="hero hero--showcase" data-hero-gallery aria-label="{{ 'Gallery'|t }}">
  <div class="hero__media" aria-hidden="true">
    <img class="hero__slide is-active" src="{{ file_url(directory ~ '/home-hero.webp') }}" alt="" width="1528" height="888" fetchpriority="high">
    <img class="hero__slide" src="{{ file_url(directory ~ '/company-bg.webp') }}" alt="" width="1486" height="760" decoding="async">
    <img class="hero__slide" src="{{ file_url(directory ~ '/capabilities-bg.webp') }}" alt="" width="1490" height="796" decoding="async">
  </div>
  <div class="container container--wide hero__layout">
    <div class="hero__inner">
      <span class="eyebrow">{{ 'Bethlehem · Palestine · Since 1998'|t }}</span>
      <h1>{{ 'Al-Baron'|t }}</h1>
      <p class="hero__subtitle">{{ 'The Enduring Beauty of'|t }} {{ 'Palestinian Stone'|t }}</p>
      <a class="hero__collection" href="{{ path('albaron_core.products') }}">{{ 'Explore the Collection'|t }} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
  <div class="hero__controls" hidden>
    <button type="button" data-hero-prev aria-label="{{ 'Previous image'|t }}" title="{{ 'Previous image'|t }}"><span aria-hidden="true">&larr;</span></button>
    <span class="hero__counter" dir="ltr" aria-live="off">01 / 03</span>
    <button type="button" data-hero-next aria-label="{{ 'Next image'|t }}" title="{{ 'Next image'|t }}"><span aria-hidden="true">&rarr;</span></button>
    <button type="button" data-hero-pause data-pause-label="{{ 'Pause slideshow'|t }}" data-play-label="{{ 'Play slideshow'|t }}" aria-label="{{ 'Pause slideshow'|t }}" title="{{ 'Pause slideshow'|t }}"><span aria-hidden="true">&#10074;&#10074;</span></button>
  </div>
</section>

{# Featured products #}
{% if featured %}
<section class="section home-collection">
  <div class="container container--wide">
    <div class="section-head section-head--center" data-reveal>
      <span class="eyebrow">{{ 'Signature Selection'|t }}</span>
      <h2>{{ 'Featured Stone & Marble'|t }}</h2>
    </div>
    {% if families %}
      <div class="home-materials">
        {% for family in families %}
          <a href="{{ family.url }}">{{ family.name }}</a>
        {% endfor %}
      </div>
    {% endif %}
    <div class="grid grid--3">
      {% for p in featured|slice(0, 3) %}
        <article class="card" data-reveal data-reveal-delay="{{ loop.index0 % 3 }}">
          <a href="{{ p.url }}" class="card__media">
            {% if p.image %}<img src="{{ p.image.src }}" alt="{{ p.image.alt }}" loading="lazy">{% endif %}
            <span class="card__media-overlay"><span class="card__view">{{ 'View details'|t }} &rarr;</span></span>
          </a>
          <div class="card__body">
            {% if p.family %}<span class="badge">{{ p.family }}</span>{% endif %}
            <h3 class="card__title" style="margin-top:.8rem;"><a href="{{ p.url }}">{{ p.title }}</a></h3>
            <dl class="card-specs">
              {% if p.finishes %}<div><dt>{{ 'Finish'|t }}</dt><dd>{{ p.finishes|join(', ') }}</dd></div>{% endif %}
              {% if p.dimensions %}<div><dt>{{ 'Size'|t }}</dt><dd>{{ p.dimensions }}</dd></div>{% endif %}
              {% if p.applications %}<div><dt>{{ 'Uses'|t }}</dt><dd>{{ p.applications|join(', ') }}</dd></div>{% endif %}
            </dl>
          </div>
        </article>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:3rem;">
      <a href="{{ path('albaron_core.products') }}" class="btn btn--primary">{{ 'View All Products'|t }}</a>
    </div>
  </div>
</section>
{% endif %}

{% if applications %}
<section class="section section--panel home-applications">
  <div class="container container--wide split">
    <div data-reveal>
      <span class="eyebrow">{{ 'Applications'|t }}</span>
      <h2>{{ 'Stone for every space'|t }}</h2>
      <div class="home-application-links">
        {% for application in applications %}
          <a href="{{ application.url }}">{{ application.name }} <span aria-hidden="true">&rarr;</span></a>
        {% endfor %}
      </div>
    </div>
    <a class="home-feature-image" href="{{ path('albaron_core.gallery') }}" aria-label="{{ 'Gallery'|t }}" data-reveal>
      <img src="{{ file_url(directory ~ '/contact-bg.webp') }}" alt="" width="1480" height="840" loading="lazy">
    </a>
  </div>
</section>
{% endif %}

<section class="section home-company">
  <div class="container container--wide">
    <div class="split">
      <a class="home-feature-image" href="{{ path('albaron_core.capabilities') }}" aria-label="{{ 'Capabilities'|t }}" data-reveal>
        <img src="{{ file_url(directory ~ '/capabilities-bg.webp') }}" alt="" width="1490" height="796" loading="lazy">
      </a>
      <div data-reveal>
        <span class="eyebrow">{{ 'Who We Are'|t }}</span>
        <h2>{{ 'Built for Export Confidence'|t }}</h2>
        <p class="lead">{{ 'From the historic quarries around Bethlehem, Al-Baron transforms raw Palestinian limestone and marble into precision-finished materials trusted on facades, floors and landmark interiors across the globe.'|t }}</p>
        <p>{{ 'Every block is selected for character and consistency, then cut, finished and packed to exacting export standards — so what you specify is exactly what arrives on site.'|t }}</p>
        <a href="{{ path('albaron_core.about') }}" class="btn btn--ghost">{{ 'Our Story'|t }}</a>
      </div>
    </div>
    <div class="stats home-stats">
      {% for stat in stats %}
        <div class="stat">
          <div class="stat__num">{{ stat.num }}</div>
          <div class="stat__label">{{ stat.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if projects %}
<section class="section section--panel home-collection">
  <div class="container container--wide">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ 'Projects'|t }}</span>
      <h2>{{ 'Project Examples'|t }}</h2>
    </div>
    <div class="grid grid--3">
      {% for project in projects %}
        <article class="card" data-reveal>
          {% if project.image %}
            <a class="card__media" href="{{ project.url }}" tabindex="-1" aria-hidden="true"><img src="{{ project.image.src }}" alt="" loading="lazy"></a>
          {% endif %}
          <div class="card__body">
            <h3 class="card__title"><a href="{{ project.url }}">{{ project.title }}</a></h3>
            <p>{{ project.summary }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
    <a class="btn btn--ghost" href="{{ path('albaron_core.projects') }}">{{ 'Projects'|t }}</a>
  </div>
</section>
{% endif %}

{% if latest_news %}
<section class="section home-news">
  <div class="container container--wide">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ 'Latest News'|t }}</span>
      <h2>{{ 'News'|t }}</h2>
    </div>
    <article class="split" data-reveal>
      {% if latest_news.image %}
        <a class="home-feature-image" href="{{ latest_news.url }}" tabindex="-1" aria-hidden="true"><img src="{{ latest_news.image.large }}" alt="" loading="lazy"></a>
      {% endif %}
      <div>
        <time datetime="{{ latest_news.datetime }}">{{ latest_news.date }}</time>
        <h3><a href="{{ latest_news.url }}">{{ latest_news.title }}</a></h3>
        <a class="btn btn--ghost" href="{{ path('albaron_core.news') }}">{{ 'All News'|t }}</a>
      </div>
    </article>
  </div>
</section>
{% endif %}

{# CTA #}
<section class="section">
  <div class="container">
    <div class="cta-band" data-reveal>
      <span class="eyebrow" style="justify-content:center;">{{ 'Start Your Project'|t }}</span>
      <h2 style="max-width:20ch;margin-inline:auto;">{{ 'Let’s bring timeless stone to your next build.'|t }}</h2>
      <p class="lead" style="max-width:52ch;margin-inline:auto;">{{ 'Tell us about your project and our export team will respond with samples, specifications and pricing.'|t }}</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:1.8rem;">
        <a href="{{ path('albaron_core.contact') }}" class="btn btn--primary">{{ 'Request a Quote'|t }}</a>
        <a href="{{ path('albaron_core.products') }}" class="btn btn--ghost">{{ 'Download Catalogue'|t }}</a>
      </div>
    </div>
  </div>
</section>
