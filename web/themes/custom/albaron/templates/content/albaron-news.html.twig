{#
/**
 * @file
 * Al-Baron news listing. Available: items (title, url, summary, date, image).
 */
#}
<section class="page-banner">
  <div class="page-banner__media" aria-hidden="true">
    <img src="{{ file_url(directory ~ '/news-bg.webp') }}" alt="" width="1558" height="482" fetchpriority="high">
  </div>
  <div class="container container--wide">
    <span class="eyebrow">{{ 'Newsroom'|t }}</span>
    <h1>{{ 'News & Updates'|t }}</h1>
    <p class="lead" style="max-width:56ch;">{{ 'Announcements, trade-show appearances and milestones from Al-Baron — Palestinian natural stone for the world.'|t }}</p>
  </div>
</section>

<section class="section">
  <div class="container container--wide">
    {% if items %}
      <div class="grid grid--3">
        {% for item in items %}
          <article class="card" data-reveal data-reveal-delay="{{ loop.index0 % 3 }}">
            <a href="{{ item.url }}" class="card__media">
              {% if item.image %}<img src="{{ item.image.src }}" alt="{{ item.image.alt }}" loading="lazy">{% endif %}
              <span class="card__media-overlay"><span class="card__view">{{ 'Read more'|t }} &rarr;</span></span>
            </a>
            <div class="card__body">
              {% if item.date %}<span class="card__date">{{ item.date }}</span>{% endif %}
              <h3 class="card__title" style="margin-top:.6rem;"><a href="{{ item.url }}">{{ item.title }}</a></h3>
              {% if item.summary %}<p class="card__excerpt">{{ item.summary }}</p>{% endif %}
              <a href="{{ item.url }}" class="card__link">{{ 'Read more'|t }} &rarr;</a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="form-card" style="text-align:center;">
        <h3>{{ 'No news yet'|t }}</h3>
        <p>{{ 'Please check back soon for Al-Baron announcements and updates.'|t }}</p>
      </div>
    {% endif %}
  </div>
</section>
