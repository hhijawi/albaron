{#
/**
 * @file
 * Al-Baron contact page: company details + inquiry form.
 */
#}
<section class="page-banner">
  <div class="container container--wide">
    <span class="eyebrow">{{ 'Get in Touch'|t }}</span>
    <h1>{{ 'Contact & Export Inquiries'|t }}</h1>
    <p class="lead" style="max-width:56ch;">{{ 'Tell us about your project — material, finish and quantity — and our export team will respond with samples, specifications and pricing.'|t }}</p>
  </div>
</section>

<section class="section">
  <div class="container container--wide">
    <div class="split" style="grid-template-columns:0.8fr 1.2fr;align-items:start;gap:3rem;">

      <div data-reveal>
        <h3>{{ 'Al-Baron Co.'|t }}</h3>
        <p>{{ 'Natural Stone & Marble — Bethlehem, Palestine.'|t }}</p>

        <table class="spec-table">
          <tr><th>{{ 'Location'|t }}</th><td>{{ 'Bethlehem, Palestine'|t }}</td></tr>
          <tr><th>{{ 'WhatsApp'|t }}</th><td><a href="https://wa.me/972595554446">+972 59&#8209;555&#8209;4446</a></td></tr>
          <tr><th>{{ 'Email'|t }}</th><td><a href="mailto:info@albaron.ps">info@albaron.ps</a></td></tr>
          <tr><th>{{ 'Social'|t }}</th><td>@Albaron.stone</td></tr>
        </table>

        <div class="social" style="margin-top:1.5rem;">
          <a href="https://www.facebook.com/ALBARONCOM/" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.5l.5-3H14V9c0-.6.4-1 1-1z"/></svg></a>
          <a href="https://www.instagram.com/albaron.stone/" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href="https://wa.me/972595554446" aria-label="WhatsApp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2z"/></svg></a>
        </div>
      </div>

      <div class="form-card" data-reveal data-reveal-delay="1">
        {% if form %}
          {{ form }}
        {% else %}
          <p>{{ 'The inquiry form is being configured.'|t }}</p>
        {% endif %}
      </div>

    </div>
  </div>
</section>
