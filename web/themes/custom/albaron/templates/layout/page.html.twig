{#
/**
 * @file
 * Al-Baron theme — main page layout.
 */
#}
<div class="page{{ is_front ? ' page--front' : '' }}">

  <header class="site-header" role="banner">
    <div class="container container--wide">
      <div class="site-header__inner">

        <div class="header-utility">
          <div class="lang-switcher">{{ drupal_block('language_block:language_interface', wrapper=false) }}</div>
        </div>

        <a href="{{ path('<front>') }}" class="site-branding" rel="home" aria-label="{{ site_name }}">
          <span class="site-branding__logo"><img src="{{ base_path ~ directory }}/logo.png" width="170" height="295" alt="{{ site_name }}"></span>
          <span>
            <span class="site-branding__name">AL&#8209;<b>BARON</b></span>
            <span class="site-branding__tag">{{ 'Natural Stone & Marble'|t }}</span>
          </span>
        </a>

        <nav id="primary-navigation" class="primary-nav" role="navigation" aria-label="{{ 'Primary'|t }}">
          {{ drupal_menu('main') }}
        </nav>

        <div class="header-actions">
          <button type="button" class="theme-toggle" data-theme-toggle data-light-label="{{ 'Switch to light theme'|t }}" data-dark-label="{{ 'Switch to dark theme'|t }}" aria-label="{{ 'Switch to light theme'|t }}" hidden>
            <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
            <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>
          </button>
          <a href="{{ path('albaron_core.contact') }}" class="btn btn--ghost btn--sm">{{ 'Contact'|t }}</a>
          <button class="nav-toggle" aria-label="{{ 'Toggle menu'|t }}" aria-expanded="false" aria-controls="primary-navigation">
            <span></span><span></span><span></span>
          </button>
        </div>

      </div>
    </div>
  </header>
  <div class="nav-backdrop"></div>

  {% if page.hero %}
    {{ page.hero }}
  {% endif %}

  {% if page.breadcrumb %}
    <div class="breadcrumb-bar">
      <div class="container container--wide">{{ page.breadcrumb }}</div>
    </div>
  {% endif %}

  <main role="main" id="main-content">
    {% if page.highlighted %}
      <div class="container">{{ page.highlighted }}</div>
    {% endif %}

    {% if page.content_top %}{{ page.content_top }}{% endif %}

    {{ page.content }}

    {% if page.content_bottom %}{{ page.content_bottom }}{% endif %}
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="container container--wide">
      <div class="site-footer__grid">

        <div class="site-footer__brand">
          <a href="{{ path('<front>') }}" class="site-branding" rel="home">
            <span class="site-branding__logo"><img src="{{ base_path ~ directory }}/logo.png" width="170" height="295" alt="{{ site_name }}"></span>
            <span class="site-branding__name">AL&#8209;<b>BARON</b></span>
          </a>
          <p style="margin-top:1.2rem;max-width:34ch;">
            {{ 'Premium Palestinian natural stone & marble from Bethlehem — quarried, crafted and delivered for export projects worldwide.'|t }}
          </p>
          <div class="social" aria-label="{{ 'Social media'|t }}">
            <a href="https://www.facebook.com/ALBARONCOM/" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.5l.5-3H14V9c0-.6.4-1 1-1z"/></svg>
            </a>
            <a href="https://www.instagram.com/albaron.stone/" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://wa.me/972566777776" aria-label="WhatsApp" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.3c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.1.3.7 1.1 1.4 1.8 1 .8 1.7 1.1 2 1.2.2.1.4.1.5-.1l.7-.8c.2-.2.4-.2.6-.1l1.7.8c.3.1.4.2.5.3.1.2.1.7-.1 1.3z"/></svg>
            </a>
          </div>
        </div>

        <div>
          <div class="footer-heading">{{ 'Explore'|t }}</div>
          {{ drupal_menu('main') }}
        </div>

        <div>
          <div class="footer-heading">{{ 'Contact'|t }}</div>
          <ul class="footer-menu">
            <li>{{ 'Main Street, Marah Rabah, Bethlehem, Palestine'|t }}</li>
            <li>{{ 'Phone'|t }}: <a href="tel:+970594499995" dir="ltr">+970 594 499 995</a></li>
            <li>{{ 'WhatsApp'|t }}: <a href="https://wa.me/972566777776" dir="ltr">+972 56-677-7776</a></li>
            <li><a href="mailto:albaronstone@gmail.com" dir="ltr">albaronstone@gmail.com</a></li>
            <li><a href="https://albaronstone.com" dir="ltr">albaronstone.com</a></li>
            <li>@Albaron.stone</li>
          </ul>
        </div>

        <div>
          <div class="footer-heading">{{ 'Get the Catalogue'|t }}</div>
          <p style="font-size:.9rem;">{{ 'Download our full bilingual stone & marble catalogue.'|t }}</p>
          <a href="#" class="btn btn--ghost btn--sm">{{ 'Download PDF'|t }}</a>
        </div>

      </div>

      <div class="site-footer__bottom">
        <span>&copy; {{ 'now'|date('Y') }} Al-Baron Co. {{ 'All rights reserved.'|t }}</span>
        <span>{{ 'Crafted by TopShelf Technology'|t }}</span>
      </div>
    </div>
  </footer>

</div>
